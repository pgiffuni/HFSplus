# Test images ARE committed: a suite that needs hfsprogs installed only runs
# where hfsprogs is installed. They are small (1 MiB each) for that reason.
/target
tests/images/public/*
tests/images/macos/*
!tests/images/public/.gitkeep
!tests/images/macos/.gitkeep
!tests/images/expected/.gitkeep

# Manifests are committed: they are the test specification.
!tests/images/manifests/

# mktorn.py imports makejournal.py to reuse its journal layout and checksum.
__pycache__/
*.pyc
